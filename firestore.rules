rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasProjectPermission(projectId, permission) {
      return isSignedIn() && exists(/databases/$(database)/documents/projects/$(projectId)) &&
        get(/databases/$(database)/documents/projects/$(projectId)).data.members[request.auth.uid].role in ["owner", "admin", "member", "viewer"] &&
        (
          permission == "read" ||
          get(/databases/$(database)/documents/projects/$(projectId)).data.members[request.auth.uid].role in ["owner", "admin", "member"]
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /test/connection {
      allow read: if isSignedIn();
    }

    match /users/{userId} {
      allow read, update, delete: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.ownerId == userId;
    }

    match /users/{userId}/projects/{projectId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if isOwner(userId);
    }

    match /projects/{projectId} {
      allow read: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in resource.data.members.keys()
      );

      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;

      allow update, delete: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.members[request.auth.uid].role in ["owner", "admin"]
      );
    }

    match /projects/{projectId}/incidents/{incidentId} {
      allow read: if isSignedIn() && exists(/databases/$(database)/documents/projects/$(projectId)) && (
        get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid ||
        request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.members.keys()
      );
      allow create, update, delete: if isSignedIn() && exists(/databases/$(database)/documents/projects/$(projectId)) && (
        get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid ||
        get(/databases/$(database)/documents/projects/$(projectId)).data.members[request.auth.uid].role in ["owner", "admin", "member"]
      );
    }

    match /projects/{projectId}/securityFindings/{findingId} {
      allow read, create, update, delete: if isSignedIn() && exists(/databases/$(database)/documents/projects/$(projectId)) && (
        get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid ||
        get(/databases/$(database)/documents/projects/$(projectId)).data.members[request.auth.uid].role in ["owner", "admin", "member"]
      );
    }

    match /projects/{projectId}/engineeringMemory/{memoryId} {
      allow read: if isSignedIn() && exists(/databases/$(database)/documents/projects/$(projectId)) && (
        get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid ||
        request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.members.keys()
      );
      allow create, update, delete: if isSignedIn() && exists(/databases/$(database)/documents/projects/$(projectId)) && (
        get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid ||
        get(/databases/$(database)/documents/projects/$(projectId)).data.members[request.auth.uid].role in ["owner", "admin", "member"]
      );
    }

    match /chatSessions/{sessionId} {
      allow read, write: if isSignedIn() && request.auth.uid == resource.data.userId;
    }
  }
}
