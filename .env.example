# Gemini configuration
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Firebase Admin server configuration (never use VITE_* for these values)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_SERVICE_ACCOUNT_JSON=""
GOOGLE_APPLICATION_CREDENTIALS=""

# Cloud Run / local runtime
PORT="3000"
NODE_ENV="development"
DEMO_MODE="false"
VITE_DEMO_MODE="false"

# GitHub webhook validation (production use via Secret Manager)
GITHUB_WEBHOOK_SECRET="MY_GITHUB_WEBHOOK_SECRET"

# GitHub OAuth and encrypted server-side token storage
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_OAUTH_STATE_SECRET=""
GITHUB_TOKEN_ENCRYPTION_KEY=""

# Public base URL for hosted app usage
APP_URL="http://localhost:3000"
