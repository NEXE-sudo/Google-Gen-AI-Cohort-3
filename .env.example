# Gemini configuration
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Cloud Run / local runtime
PORT="3000"
NODE_ENV="development"

# GitHub webhook validation (production use via Secret Manager)
GITHUB_WEBHOOK_SECRET="MY_GITHUB_WEBHOOK_SECRET"

# Public base URL for hosted app usage
APP_URL="http://localhost:3000"

# Optional GitHub token for local repository sync testing
GITHUB_TOKEN=""
